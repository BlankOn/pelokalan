# Server
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
MAX_UPLOAD_MB=20

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pelokalan
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# JWT (also used to sign one-time codes)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=72

# Site
SITE_BASE_URL=http://localhost:8080
SITE_NAME=Pelokalan
# UI language when the visitor has not chosen one: id (default) or en
DEFAULT_LANG=id

# Access control
# Comma separated list of email addresses allowed to register and sign in.
# An entry starting with "@" allows a whole domain, e.g. "@example.com".
# Leave empty to allow anyone to register and sign in (open registration).
# When set, removing an address revokes access immediately.
EMAIL_WHITELIST=admin@blankon.id,alice@example.com,bob@example.com

# One-time codes
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=20
INVITATION_EXPIRATION_DAYS=14

# Email (Mailtrap)
# Leave MAILTRAP_API_TOKEN empty to run in dev mode (emails printed to console)
# Production: Email Sending API token; MAIL_FROM_EMAIL must be on a verified sending domain
# Testing: also set MAILTRAP_INBOX_ID to deliver to a sandbox inbox instead
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Pelokalan

# Glossary automatic downloads
# Each version's download URL is fetched once per interval (checked hourly)
GLOSSARY_FETCH_INTERVAL_HOURS=3
GLOSSARY_MAX_DOWNLOAD_MB=100
# Allow URLs on localhost/private networks (blocked by default to prevent abuse)
GLOSSARY_ALLOW_PRIVATE_HOSTS=false

# AI pre-translation
# Encrypts the API keys that project managers store. Defaults to JWT_SECRET;
# set it explicitly so rotating JWT_SECRET does not make stored keys unreadable.
AI_SECRET_KEY=
# Allow AI API URLs on localhost/private networks (e.g. a self-hosted model server)
AI_ALLOW_PRIVATE_HOSTS=false
